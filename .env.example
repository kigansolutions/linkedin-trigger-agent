# Claude subscription auth (generate with `claude setup-token` in your own terminal,
# then paste the resulting token here — do NOT run setup-token on someone else's behalf)
CLAUDE_CODE_OAUTH_TOKEN=

# ClickUp — Settings -> Apps -> API Token (personal token, starts with pk_)
CLICKUP_API_KEY=

# The ClickUp list this pipeline writes drafts into (created during setup)
CLICKUP_LIST_ID=

# Windows only, local dev only: path to your Claude Code executable (e.g. from `where claude`).
# Works around the Agent SDK's win32-x64 native binary not being available as an optional
# dependency. Not needed on Linux/macOS, and not needed for the deployed (Linux) target.
CLAUDE_CODE_EXECUTABLE_PATH=
