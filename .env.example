# Claude subscription auth (generate with `claude setup-token` in your own terminal,
# then paste the resulting token here — do NOT run setup-token on someone else's behalf)
CLAUDE_CODE_OAUTH_TOKEN=

# ClickUp — Settings -> Apps -> API Token (personal token, starts with pk_)
CLICKUP_API_KEY=

# The ClickUp list this pipeline writes drafts into (created during setup)
CLICKUP_LIST_ID=

# Composio — app.composio.dev -> Settings -> API Keys. Reddit must also be connected
# under this same project (Toolkits -> Reddit -> Connect) or fetches return no posts.
COMPOSIO_API_KEY=

# The connected_account_id from Composio's Reddit connection (GET /api/v3/connected_accounts).
COMPOSIO_REDDIT_CONNECTED_ACCOUNT_ID=

# The user_id field on that same connected account. Composio requires both together —
# connected_account_id alone 400s with ActionExecute_ConnectedAccountEntityIdRequired.
COMPOSIO_REDDIT_USER_ID=

# Tavily — app.tavily.com, free tier available. Fallback source when the Composio Reddit
# fetch returns nothing (not connected, rate limited, subreddits quiet, etc).
TAVILY_API_KEY=

# Windows only, local dev only: path to your Claude Code executable (e.g. from `where claude`).
# Works around the Agent SDK's win32-x64 native binary not being available as an optional
# dependency. Not needed on Linux/macOS, and not needed for the deployed (Linux) target.
CLAUDE_CODE_EXECUTABLE_PATH=
